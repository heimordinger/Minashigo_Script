/* 脚本生成窗口 · 暗色 */
QWidget#ScriptGenWindow,
QWidget#ScriptGenPanel {
    background-color: #16181c;
}

QTabWidget#ScriptGenTabs::pane {
    border: none;
    border-top: 1px solid #2c3138;
    background-color: #16181c;
    padding: 4px 2px 0 2px;
}

QTabWidget#ScriptGenTabs QTabBar::tab {
    padding: 10px 20px;
    font-size: 13px;
}

QWidget#GenTrajectory {
    background: transparent;
}

QLabel#GenTrajectoryEmpty {
    color: #8b929c;
    font-size: 13px;
    padding: 48px 32px;
    background: transparent;
}

QFrame#GenTrajectoryStep {
    background: transparent;
    border: none;
    border-radius: 8px;
}

QFrame#GenTrajectoryBodyCard {
    background-color: #1c1f24;
    border: 1px solid #2c3138;
    border-radius: 8px;
}

QLabel#GenTrajectoryBody {
    color: #c5cad3;
    font-size: 12px;
    background: transparent;
}

QLabel#GenTrajectorySummary {
    color: #8b929c;
    background: transparent;
}

QProgressBar#ScriptGenProgress {
    background-color: #23272e;
    border: none;
    border-radius: 3px;
    min-height: 6px;
    max-height: 6px;
}

QProgressBar#ScriptGenProgress::chunk {
    background-color: #5b8def;
    border-radius: 3px;
}

/* Agent 顶栏 */
QFrame#AgentRunStrip {
    background-color: #1c1f24;
    border: 1px solid #2c3138;
    border-radius: 10px;
}

QLabel#AgentRunPhase {
    color: #e8eaed;
    background: transparent;
}

QLabel#AgentRunDot {
    color: #6b7280;
    background: transparent;
    font-size: 11px;
}

QLabel#AgentRunDot[busy="true"] {
    color: #5b8def;
}

QLabel#AgentRunDot[success="true"] {
    color: #4ade80;
}

QLabel#GenResultBanner {
    background-color: #14532d;
    color: #bbf7d0;
    border: 1px solid #166534;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 600;
}

QLabel#GenResultBanner[busy="true"] {
    background-color: #1e3a5f;
    color: #bfdbfe;
    border: 1px solid #3b82f6;
}

QLabel#GenResultBanner[warn="true"] {
    background-color: #7c2d12;
    color: #ffedd5;
    border: 1px solid #ea580c;
}

QPushButton#PrimaryButton[ready="true"] {
    background-color: #16a34a;
    border-color: #15803d;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#PrimaryButton[ready="true"]:hover {
    background-color: #22c55e;
}

QTextEdit#AgentLiveCode {
    background-color: #12141a;
    border: 1px solid #2c3138;
    border-radius: 8px;
    color: #c5cad3;
    padding: 8px;
    selection-background-color: #3b4f6e;
}

QLabel#TrialStageChip {
    background-color: #23272e;
    color: #8b929c;
    border: 1px solid #2c3138;
    border-radius: 11px;
    padding: 0 10px;
    font-size: 11px;
}

QLabel#TrialStageChip[stage="active"] {
    background-color: #1e3a5f;
    color: #93c5fd;
    border-color: #3b82f6;
}

QLabel#TrialStageChip[stage="done"] {
    background-color: #14532d;
    color: #86efac;
    border-color: #22c55e;
}

QLabel#TrialFramePreview {
    background-color: #12141a;
    border: 1px dashed #2c3138;
    border-radius: 8px;
    color: #8b929c;
    font-size: 12px;
    padding: 8px;
}

QTextEdit#ScriptGenFeedback {
    background-color: #1c1f24;
    border: 1px solid #2c3138;
    border-radius: 6px;
}

QTextEdit#ScriptGenFeedback[stale="true"] {
    background-color: #2a2418;
    border: 1px solid #6b5420;
    color: #e0c48a;
}


/* ── 试运行 Live HUD ── */
QFrame#TrialHudCard {
    background-color: #1c1f24;
    border: 1px solid #2c3138;
    border-radius: 10px;
}
QLabel#TrialHudDot {
    background-color: #3a4148;
    border-radius: 5px;
    min-width: 10px; max-width: 10px;
    min-height: 10px; max-height: 10px;
}
QLabel#TrialHudDot[state="running"] { background-color: #5b8def; }
QLabel#TrialHudDot[state="running"][pulse="1"] { background-color: #a8c6ff; }
QLabel#TrialHudDot[state="ok"]  { background-color: #6fbf8a; }
QLabel#TrialHudDot[state="warn"] { background-color: #c9a227; }
QLabel#TrialHudDot[state="err"] { background-color: #d16b6b; }
QLabel#TrialHudStateText { color: #e8eaed; font-weight: bold; font-size: 12px; background: transparent; }
QLabel#TrialHudAccount   { color: #e8eaed; font-weight: bold; font-size: 12px; background: transparent; }
QLabel#TrialHudStateBadge { color: #a8c6ff; background: transparent; font-size: 12px; font-family: "Consolas", "Microsoft YaHei UI"; }
QLabel#TrialHudAction    { color: #8b929c; background: transparent; font-size: 12px; }
QLabel#TrialHudTimer     { color: #8b929c; background: transparent; font-size: 12px; font-family: "Consolas"; }
QLabel#TrialHudMuted     { color: #565d66; background: transparent; font-size: 12px; }
QLabel#TrialHudVerdict   { border-radius: 9px; padding: 1px 8px; font-size: 11px; background: transparent; }
QLabel#TrialHudVerdict[level="pass"]    { color: #6fbf8a; border: 1px solid #2f5b3e; }
QLabel#TrialHudVerdict[level="partial"] { color: #c9a227; border: 1px solid #6b5420; }
QLabel#TrialHudVerdict[level="fail"]    { color: #d16b6b; border: 1px solid #5a3434; }
QLabel#TrialHudVerdict[reliability="risk"] { background-color: #3a2222; color: #ef9a9a; border: 1px solid #d16b6b; }
QLabel#TrialHudVerdict[reliability="ok"]   { background-color: #1e2f24; color: #8fd6a5; border: 1px solid #4caf7a; }
/* ── 协作工作台 ── */
QLabel#CollabPreviewBanner {
    color: #c9a227;
    background-color: #2a2618;
    border: 1px solid #6b5420;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 12px;
}
QFrame#CollabChatPane,
QFrame#CollabFramePane,
QFrame#CollabLogicPane {
    background-color: #1c1f24;
    border: 1px solid #2c3138;
    border-radius: 10px;
}
QFrame#CollabFramePane[dragOver="true"] {
    border: 1px dashed #5b8def;
    background-color: #1a2333;
}
QWidget#CollabLogicRail {
    background-color: #1c1f24;
    border: 1px solid #3a4148;
    border-radius: 10px 0 0 10px;
}
QFrame#CollabLogicGrip {
    background-color: #3a4148;
    border: none;
    max-width: 6px;
}
QFrame#CollabLogicGrip:hover {
    background-color: #5b8def;
}
QSplitter#CollabSplitter::handle {
    background-color: #2c3138;
    width: 8px;
    margin: 4px 0;
    border-radius: 2px;
}
QSplitter#CollabSplitter::handle:hover {
    background-color: #5b8def;
}
QLabel#CollabViewportBadge {
    color: #e8eaed;
    background-color: rgba(22, 24, 28, 210);
    border: 1px solid #3a4148;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 11px;
}
QToolButton#CollabLogicEdge {
    background-color: #243044;
    border: 1px solid #3a5478;
    border-radius: 6px;
    color: #c5cad3;
    font-size: 12px;
    padding: 8px 2px;
}
QToolButton#CollabLogicEdge:hover {
    background-color: #2c3d56;
    color: #e8eaed;
}
QWidget#CollabLogicRail[alert="true"] {
    border: 2px solid #e0a020;
    background-color: #3a3018;
}
QToolButton#CollabLogicEdge[alert="true"] {
    background-color: #e0a020;
    border: 1px solid #f0c14a;
    color: #1a1408;
    font-weight: 700;
}
QLabel#CollabSectionTitle {
    color: #e8eaed;
    background: transparent;
}
QLabel#CollabPermHint {
    color: #8b929c;
    font-size: 11px;
    background: transparent;
}
QLabel#CollabPermStatus {
    color: #9aa7bd;
    font-size: 11px;
    background: transparent;
    padding: 2px 0;
}
QFrame#CollabAssetRail {
    background-color: #1c1f24;
    border: 1px solid #2c3138;
    border-radius: 8px;
}
QFrame#CollabAssetRail[dragOver="true"] {
    border: 1px dashed #5b8def;
    background-color: #1a2333;
}
QToolButton#CollabAssetThumb {
    background-color: #23272e;
    border: 1px solid #2c3138;
    border-radius: 6px;
    color: #c5cad3;
    font-size: 10px;
    padding: 2px;
}
QToolButton#CollabAssetThumb[focused="true"] {
    border: 1px solid #5b8def;
    color: #e8eaed;
}
QFrame#CollabPermAsk {
    background-color: #243044;
    border: 1px solid #3a5478;
    border-radius: 8px;
}
QLabel#CollabPermAskTitle {
    color: #e8eaed;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}
QLabel#CollabPermAskBody {
    color: #aeb6c2;
    font-size: 11px;
    background: transparent;
}
QCheckBox#CollabPermCheck {
    color: #c5cad3;
    font-size: 11px;
    spacing: 4px;
}
QCheckBox#CollabPermCheck::indicator {
    width: 13px;
    height: 13px;
}
QFrame#CollabBubbleAgent {
    background-color: #23272e;
    border: 1px solid #2c3138;
    border-radius: 12px;
}
QFrame#CollabBubbleUser {
    background-color: #243044;
    border: 1px solid #3a5478;
    border-radius: 12px;
}
QFrame#CollabBubbleSystem {
    background-color: #1c1f24;
    border: 1px dashed #3a4148;
    border-radius: 8px;
}
QLabel#CollabBubbleRole {
    color: #8b929c;
    font-size: 11px;
    background: transparent;
}
QLabel#CollabBubbleRoleAgent {
    color: #7aa2f0;
    font-size: 11px;
    font-weight: 600;
    background: transparent;
}
QLabel#CollabBubbleRoleUser {
    color: #8eb0e0;
    font-size: 11px;
    font-weight: 600;
    background: transparent;
}
QLabel#CollabBubbleSystemTag {
    color: #9aa3ad;
    font-size: 11px;
    font-weight: 600;
    background-color: #2a3038;
    border-radius: 4px;
    padding: 1px 6px;
    max-height: 18px;
}
QLabel#CollabBubbleSystemBody {
    color: #a8b0ba;
    font-size: 12px;
    background: transparent;
}
QLabel#CollabBubbleBody {
    color: #e8eaed;
    font-size: 13px;
    background: transparent;
}
QFrame#CollabActivityBar {
    background: transparent;
    border: none;
}
QLabel#CollabActivityDot {
    color: #8ab4ff;
    font-size: 11px;
    font-weight: 700;
    background: transparent;
}
QLabel#CollabActivityText {
    color: #f2f2f2;
    font-size: 12px;
    font-weight: 700;
    background: transparent;
}
QFrame#CollabBubbleProcess {
    background-color: transparent;
    border: none;
}
QLabel#CollabProcessBody {
    color: #8b929c;
    font-size: 11px;
    background: transparent;
    padding: 0 4px;
}
QLabel#CollabHintLine {
    color: #f2f2f2;
    font-size: 12px;
    font-weight: 700;
    background: transparent;
    padding: 0 2px;
}
QFrame#CollabComposer {
    background-color: #1a1d22;
    border: 1px solid #2c3138;
    border-radius: 12px;
}
QToolButton#CollabSwitchBtn,
QToolButton#CollabHistoryBtn {
    background: transparent;
    border: none;
    color: #8b929c;
    font-size: 11px;
    padding: 2px 6px;
    border-radius: 6px;
}
QToolButton#CollabSwitchBtn:hover,
QToolButton#CollabHistoryBtn:hover {
    background-color: #23272e;
    color: #e8eaed;
}
QToolButton#CollabSwitchBtn::menu-indicator,
QToolButton#CollabHistoryBtn::menu-indicator {
    image: none;
    width: 0px;
}
QPushButton#CollabSendBtn {
    background-color: #5b8def;
    color: #0e1013;
    border: none;
    border-radius: 6px;
    padding: 2px 10px;
    font-size: 11px;
}
QPushButton#CollabSendBtn:hover {
    background-color: #7aa2f5;
}
QPushButton#CollabSendBtn[busy="true"] {
    background-color: #e07a6a;
    color: #1a1010;
}
QPushButton#CollabSendBtn[busy="true"]:hover {
    background-color: #f09080;
}
QPushButton#CollabChip {
    background-color: #23272e;
    color: #c5cad3;
    border: 1px solid #3a4148;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
    max-height: 26px;
}
QPushButton#CollabChip:hover {
    border-color: #5b8def;
    color: #e8eaed;
}
QLineEdit#CollabChatInput,
QTextEdit#CollabChatInput {
    background-color: transparent;
    border: none;
    border-radius: 0;
    padding: 2px 2px;
    color: #e8eaed;
}
QTextEdit#CollabChatInput {
    min-height: 36px;
}
QLabel#CollabFramePlaceholder {
    color: #8b929c;
    background-color: #16181c;
    border: 1px dashed #3a4148;
    border-radius: 8px;
    font-size: 13px;
}
QLabel#LogicStepThumb {
    background-color: #16181c;
    border: 1px solid #3a4148;
    border-radius: 6px;
    color: #8b929c;
    font-size: 14px;
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
}
QLineEdit#LogicStepParam {
    padding: 0 4px;
    min-height: 0;
    border-radius: 4px;
}
QFrame#LogicStepCard {
    background-color: #23272e;
    border: 1px solid #2c3138;
    border-radius: 8px;
}
QFrame#LogicStepCard:hover {
    border-color: #4a525c;
}
QFrame#LogicStepCard[stepStatus="preview"] {
    border-color: #5b8def;
}
QFrame#LogicStepCard[stepStatus="acked"] {
    border-color: #6fbf8a;
}
QFrame#LogicStepCard[stepStatus="failed"] {
    border-color: #d16b6b;
}
QLabel#LogicStepTitle {
    color: #e8eaed;
    background: transparent;
}
QLabel#LogicStepBadge {
    color: #8b929c;
    font-size: 11px;
    background: transparent;
    padding: 1px 6px;
}
QLabel#LogicStepBadge[stepStatus="preview"] { color: #a8c6ff; }
QLabel#LogicStepBadge[stepStatus="acked"] { color: #8fd6a5; }
QLabel#LogicStepBadge[stepStatus="failed"] { color: #ef9a9a; }
QFrame#CollabTrialBar {
    background-color: #1c1f24;
    border: 1px solid #2c3138;
    border-radius: 10px;
}
