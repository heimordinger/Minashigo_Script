/* 脚本生成窗口 · 暗色 */
QWidget#ScriptGenWindow,
QWidget#ScriptGenPanel {
    background-color: #16181c;
}

QTabWidget#ScriptGenTabs::pane {
    border: none;
    border-top: 1px solid #2c3138;
    background-color: #16181c;
    padding: 4px 2px 0 2px;
}

QTabWidget#ScriptGenTabs QTabBar::tab {
    padding: 10px 20px;
    font-size: 13px;
}

QWidget#GenTrajectory {
    background: transparent;
}

QLabel#GenTrajectoryEmpty {
    color: #8b929c;
    font-size: 13px;
    padding: 48px 32px;
    background: transparent;
}

QFrame#GenTrajectoryStep {
    background: transparent;
    border: none;
    border-radius: 8px;
}

QFrame#GenTrajectoryBodyCard {
    background-color: #1c1f24;
    border: 1px solid #2c3138;
    border-radius: 8px;
}

QLabel#GenTrajectoryBody {
    color: #c5cad3;
    font-size: 12px;
    background: transparent;
}

QLabel#GenTrajectorySummary {
    color: #8b929c;
    background: transparent;
}

QProgressBar#ScriptGenProgress {
    background-color: #23272e;
    border: none;
    border-radius: 3px;
    min-height: 6px;
    max-height: 6px;
}

QProgressBar#ScriptGenProgress::chunk {
    background-color: #5b8def;
    border-radius: 3px;
}

QTextEdit#ScriptGenFeedback {
    background-color: #1c1f24;
    border: 1px solid #2c3138;
    border-radius: 6px;
}

QTextEdit#ScriptGenFeedback[stale="true"] {
    background-color: #2a2418;
    border: 1px solid #6b5420;
    color: #e0c48a;
}
