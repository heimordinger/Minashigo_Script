/* 脚本生成窗口 · 亮色 */
QWidget#ScriptGenWindow,
QWidget#ScriptGenPanel {
    background-color: #f4f2ed;
}

QTabWidget#ScriptGenTabs::pane {
    border: none;
    border-top: 1px solid #ddd8ce;
    background-color: #f4f2ed;
    padding: 4px 2px 0 2px;
}

QTabWidget#ScriptGenTabs QTabBar::tab {
    padding: 10px 20px;
    font-size: 13px;
}

QWidget#GenTrajectory {
    background: transparent;
}

QLabel#GenTrajectoryEmpty {
    color: #9a958c;
    font-size: 13px;
    padding: 48px 32px;
    background: transparent;
}

QFrame#GenTrajectoryStep {
    background: transparent;
    border: none;
    border-radius: 8px;
}

QFrame#GenTrajectoryBodyCard {
    background-color: #faf8f4;
    border: 1px solid #e6e1d6;
    border-radius: 8px;
}

QLabel#GenTrajectoryBody {
    color: #5c5952;
    font-size: 12px;
    background: transparent;
}

QLabel#GenTrajectorySummary {
    color: #6b6560;
    background: transparent;
}

QProgressBar#ScriptGenProgress {
    background-color: #ebe8e1;
    border: none;
    border-radius: 3px;
    min-height: 6px;
    max-height: 6px;
}

QProgressBar#ScriptGenProgress::chunk {
    background-color: #3b6fd8;
    border-radius: 3px;
}

QTextEdit#ScriptGenFeedback {
    background-color: #ffffff;
    border: 1px solid #ddd8ce;
    border-radius: 6px;
}

QTextEdit#ScriptGenFeedback[stale="true"] {
    background-color: #fff8eb;
    border: 1px solid #e0c48a;
    color: #6b5420;
}
