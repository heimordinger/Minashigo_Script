/* 脚本生成窗口 · 亮色 */
QWidget#ScriptGenWindow,
QWidget#ScriptGenPanel {
    background-color: #f4f2ed;
}

QTabWidget#ScriptGenTabs::pane {
    border: none;
    border-top: 1px solid #ddd8ce;
    background-color: #f4f2ed;
    padding: 4px 2px 0 2px;
}

QTabWidget#ScriptGenTabs QTabBar::tab {
    padding: 10px 20px;
    font-size: 13px;
}

QWidget#GenTrajectory {
    background: transparent;
}

QLabel#GenTrajectoryEmpty {
    color: #9a958c;
    font-size: 13px;
    padding: 48px 32px;
    background: transparent;
}

QFrame#GenTrajectoryStep {
    background: transparent;
    border: none;
    border-radius: 8px;
}

QFrame#GenTrajectoryBodyCard {
    background-color: #faf8f4;
    border: 1px solid #e6e1d6;
    border-radius: 8px;
}

QLabel#GenTrajectoryBody {
    color: #5c5952;
    font-size: 12px;
    background: transparent;
}

QLabel#GenTrajectorySummary {
    color: #6b6560;
    background: transparent;
}

QProgressBar#ScriptGenProgress {
    background-color: #ebe8e1;
    border: none;
    border-radius: 3px;
    min-height: 6px;
    max-height: 6px;
}

QProgressBar#ScriptGenProgress::chunk {
    background-color: #3b6fd8;
    border-radius: 3px;
}

/* Agent 顶栏 */
QFrame#AgentRunStrip {
    background-color: #ffffff;
    border: 1px solid #ddd8ce;
    border-radius: 10px;
}

QLabel#AgentRunPhase {
    color: #2a2824;
    background: transparent;
}

QLabel#AgentRunDot {
    color: #9a958c;
    background: transparent;
    font-size: 11px;
}

QLabel#AgentRunDot[busy="true"] {
    color: #3b6fd8;
}

QLabel#AgentRunDot[success="true"] {
    color: #16a34a;
}

QLabel#GenResultBanner {
    background-color: #e8f5e9;
    color: #166534;
    border: 1px solid #86efac;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 600;
}

QLabel#GenResultBanner[busy="true"] {
    background-color: #eff6ff;
    color: #1e40af;
    border: 1px solid #93c5fd;
}

QLabel#GenResultBanner[warn="true"] {
    background-color: #fff7ed;
    color: #9a3412;
    border: 1px solid #fdba74;
}

QPushButton#PrimaryButton[ready="true"] {
    background-color: #16a34a;
    border-color: #15803d;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#PrimaryButton[ready="true"]:hover {
    background-color: #15803d;
}

QTextEdit#AgentLiveCode {
    background-color: #1e1e1e;
    border: 1px solid #ddd8ce;
    border-radius: 8px;
    color: #d4d4d4;
    padding: 8px;
    selection-background-color: #264f78;
}

QLabel#TrialStageChip {
    background-color: #ebe8e1;
    color: #6b6560;
    border: 1px solid #ddd8ce;
    border-radius: 11px;
    padding: 0 10px;
    font-size: 11px;
}

QLabel#TrialStageChip[stage="active"] {
    background-color: #e8f0fe;
    color: #1d4ed8;
    border-color: #3b6fd8;
}

QLabel#TrialStageChip[stage="done"] {
    background-color: #e8f5e9;
    color: #2e7d32;
    border-color: #4caf50;
}

QLabel#TrialFramePreview {
    background-color: #faf8f4;
    border: 1px dashed #ddd8ce;
    border-radius: 8px;
    color: #9a958c;
    font-size: 12px;
    padding: 8px;
}

QTextEdit#ScriptGenFeedback {
    background-color: #ffffff;
    border: 1px solid #ddd8ce;
    border-radius: 6px;
}

QTextEdit#ScriptGenFeedback[stale="true"] {
    background-color: #fff8eb;
    border: 1px solid #e0c48a;
    color: #6b5420;
}


/* ── 试运行 Live HUD ── */
QFrame#TrialHudCard {
    background-color: #ffffff;
    border: 1px solid #ddd8ce;
    border-radius: 10px;
}
QLabel#TrialHudDot {
    background-color: #cfc9bc;
    border-radius: 5px;
    min-width: 10px; max-width: 10px;
    min-height: 10px; max-height: 10px;
}
QLabel#TrialHudDot[state="running"] { background-color: #3b6fd8; }
QLabel#TrialHudDot[state="running"][pulse="1"] { background-color: #9ec1ff; }
QLabel#TrialHudDot[state="ok"]  { background-color: #2e7d32; }
QLabel#TrialHudDot[state="warn"] { background-color: #b8860b; }
QLabel#TrialHudDot[state="err"] { background-color: #c0392b; }
QLabel#TrialHudStateText { color: #2a2824; font-weight: bold; font-size: 12px; background: transparent; }
QLabel#TrialHudAccount   { color: #2a2824; font-weight: bold; font-size: 12px; background: transparent; }
QLabel#TrialHudStateBadge { color: #1d4ed8; background: transparent; font-size: 12px; font-family: "Consolas", "Microsoft YaHei UI"; }
QLabel#TrialHudAction    { color: #6b6560; background: transparent; font-size: 12px; }
QLabel#TrialHudTimer     { color: #6b6560; background: transparent; font-size: 12px; font-family: "Consolas"; }
QLabel#TrialHudMuted     { color: #b0aaa0; background: transparent; font-size: 12px; }
QLabel#TrialHudVerdict   { border-radius: 9px; padding: 1px 8px; font-size: 11px; background: transparent; }
QLabel#TrialHudVerdict[level="pass"]    { color: #2e7d32; border: 1px solid #a5d6a7; }
QLabel#TrialHudVerdict[level="partial"] { color: #b8860b; border: 1px solid #e0c48a; }
QLabel#TrialHudVerdict[level="fail"]    { color: #c0392b; border: 1px solid #e3a9a0; }
QLabel#TrialHudVerdict[reliability="risk"] { background-color: #fdecea; color: #b71c1c; border: 1px solid #e57373; }
QLabel#TrialHudVerdict[reliability="ok"]   { background-color: #e8f5e9; color: #1b5e20; border: 1px solid #81c784; }
/* ── 协作工作台 ── */
QLabel#CollabPreviewBanner {
    color: #8a6d1d;
    background-color: #f7f0dc;
    border: 1px solid #e0c48a;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 12px;
}
QFrame#CollabChatPane,
QFrame#CollabFramePane,
QFrame#CollabLogicPane {
    background-color: #faf8f4;
    border: 1px solid #e6e1d6;
    border-radius: 10px;
}
QWidget#CollabLogicRail {
    background-color: #faf8f4;
    border: 1px solid #d4cdc0;
    border-radius: 10px 0 0 10px;
}
QFrame#CollabLogicGrip {
    background-color: #e0dbd0;
    border: none;
    max-width: 6px;
}
QFrame#CollabLogicGrip:hover {
    background-color: #3b6fd8;
}
QSplitter#CollabSplitter::handle {
    background-color: #e6e1d6;
    width: 8px;
    margin: 4px 0;
    border-radius: 2px;
}
QSplitter#CollabSplitter::handle:hover {
    background-color: #3b6fd8;
}
QLabel#CollabViewportBadge {
    color: #2a2824;
    background-color: rgba(255, 255, 255, 210);
    border: 1px solid #d4cdc0;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 11px;
}
QFrame#CollabFramePane[dragOver="true"] {
    border: 1px dashed #3d6bb3;
    background-color: #eef3fb;
}
QToolButton#CollabLogicEdge {
    background-color: #f0ebe3;
    border: 1px solid #d4cdc0;
    border-radius: 6px;
    color: #4a463e;
    font-size: 12px;
    padding: 8px 2px;
}
QToolButton#CollabLogicEdge:hover {
    background-color: #e8e2d8;
    color: #2a2824;
}
QWidget#CollabLogicRail[alert="true"] {
    border: 2px solid #d4a017;
    background-color: #fff4d6;
}
QToolButton#CollabLogicEdge[alert="true"] {
    background-color: #f5c542;
    border: 1px solid #c48a10;
    color: #2a2824;
    font-weight: 700;
}
QLabel#CollabSectionTitle {
    color: #2a2824;
    background: transparent;
}
QLabel#CollabPermHint {
    color: #8a8478;
    font-size: 11px;
    background: transparent;
}
QLabel#CollabPermStatus {
    color: #6a6458;
    font-size: 11px;
    background: transparent;
    padding: 2px 0;
}
QFrame#CollabAssetRail {
    background-color: #f7f5f0;
    border: 1px solid #e0dbd0;
    border-radius: 8px;
}
QFrame#CollabAssetRail[dragOver="true"] {
    border: 1px dashed #3d6bb3;
    background-color: #eef3fb;
}
QToolButton#CollabAssetThumb {
    background-color: #ffffff;
    border: 1px solid #e0dbd0;
    border-radius: 6px;
    color: #4a463e;
    font-size: 10px;
    padding: 2px;
}
QToolButton#CollabAssetThumb[focused="true"] {
    border: 1px solid #4a7fd4;
    color: #2a2824;
}
QFrame#CollabPermAsk {
    background-color: #f0ebe3;
    border: 1px solid #d4cdc0;
    border-radius: 8px;
}
QLabel#CollabPermAskTitle {
    color: #2a2824;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}
QLabel#CollabPermAskBody {
    color: #5a554c;
    font-size: 11px;
    background: transparent;
}
QCheckBox#CollabPermCheck {
    color: #4a463e;
    font-size: 11px;
    spacing: 4px;
}
QCheckBox#CollabPermCheck::indicator {
    width: 13px;
    height: 13px;
}
QFrame#CollabBubbleAgent {
    background-color: #f7f5f0;
    border: 1px solid #e0dbd0;
    border-radius: 12px;
}
QFrame#CollabBubbleUser {
    background-color: #e8f0fc;
    border: 1px solid #b7c9e8;
    border-radius: 12px;
}
QFrame#CollabBubbleSystem {
    background-color: #f0efec;
    border: 1px dashed #d2cec4;
    border-radius: 8px;
}
QLabel#CollabBubbleRole {
    color: #9a958c;
    font-size: 11px;
    background: transparent;
}
QLabel#CollabBubbleRoleAgent {
    color: #3b6fd8;
    font-size: 11px;
    font-weight: 600;
    background: transparent;
}
QLabel#CollabBubbleRoleUser {
    color: #5a7ab0;
    font-size: 11px;
    font-weight: 600;
    background: transparent;
}
QLabel#CollabBubbleSystemTag {
    color: #8a8680;
    font-size: 11px;
    font-weight: 600;
    background-color: #e4e1da;
    border-radius: 4px;
    padding: 1px 6px;
    max-height: 18px;
}
QLabel#CollabBubbleSystemBody {
    color: #5c5952;
    font-size: 12px;
    background: transparent;
}
QLabel#CollabBubbleBody {
    color: #2a2824;
    font-size: 13px;
    background: transparent;
}
QFrame#CollabActivityBar {
    background: transparent;
    border: none;
}
QLabel#CollabActivityDot {
    color: #3b6fd8;
    font-size: 11px;
    font-weight: 700;
    background: transparent;
}
QLabel#CollabActivityText {
    color: #1a1a1a;
    font-size: 12px;
    font-weight: 700;
    background: transparent;
}
QFrame#CollabBubbleProcess {
    background-color: transparent;
    border: none;
}
QLabel#CollabHintLine {
    color: #1a1a1a;
    font-size: 12px;
    font-weight: 700;
    background: transparent;
    padding: 0 2px;
}
QFrame#CollabComposer {
    background-color: #ffffff;
    border: 1px solid #ddd8ce;
    border-radius: 12px;
}
QToolButton#CollabSwitchBtn,
QToolButton#CollabHistoryBtn {
    background: transparent;
    border: none;
    color: #6a6458;
    font-size: 11px;
    padding: 2px 6px;
    border-radius: 6px;
}
QToolButton#CollabSwitchBtn:hover,
QToolButton#CollabHistoryBtn:hover {
    background-color: #f0ebe3;
    color: #2a2824;
}
QToolButton#CollabSwitchBtn::menu-indicator,
QToolButton#CollabHistoryBtn::menu-indicator {
    image: none;
    width: 0px;
}
QPushButton#CollabSendBtn {
    background-color: #3b6fd8;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 2px 10px;
    font-size: 11px;
}
QPushButton#CollabSendBtn:hover {
    background-color: #2f5fc4;
}
QPushButton#CollabSendBtn[busy="true"] {
    background-color: #c45c4a;
}
QPushButton#CollabSendBtn[busy="true"]:hover {
    background-color: #a84a3a;
}
QPushButton#CollabChip {
    background-color: #f4f2ed;
    color: #5c5952;
    border: 1px solid #ddd8ce;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
    max-height: 26px;
}
QPushButton#CollabChip:hover {
    border-color: #3b6fd8;
    color: #2a2824;
}
QLineEdit#CollabChatInput,
QTextEdit#CollabChatInput {
    background-color: transparent;
    border: none;
    border-radius: 0;
    padding: 2px 2px;
    color: #2a2824;
}
QTextEdit#CollabChatInput {
    min-height: 36px;
}
QLabel#CollabFramePlaceholder {
    color: #9a958c;
    background-color: #f4f2ed;
    border: 1px dashed #ddd8ce;
    border-radius: 8px;
    font-size: 13px;
}
QLabel#LogicStepThumb {
    background-color: #f4f2ed;
    border: 1px solid #ddd8ce;
    border-radius: 6px;
    color: #9a958c;
    font-size: 14px;
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
}
QLineEdit#LogicStepParam {
    padding: 0 4px;
    min-height: 0;
    border-radius: 4px;
}
QFrame#LogicStepCard {
    background-color: #ffffff;
    border: 1px solid #e6e1d6;
    border-radius: 8px;
}
QFrame#LogicStepCard:hover {
    border-color: #c8c2b4;
}
QFrame#LogicStepCard[stepStatus="preview"] {
    border-color: #3b6fd8;
}
QFrame#LogicStepCard[stepStatus="acked"] {
    border-color: #2e7d32;
}
QFrame#LogicStepCard[stepStatus="failed"] {
    border-color: #c0392b;
}
QLabel#LogicStepTitle {
    color: #2a2824;
    background: transparent;
}
QLabel#LogicStepBadge {
    color: #9a958c;
    font-size: 11px;
    background: transparent;
    padding: 1px 6px;
}
QLabel#LogicStepBadge[stepStatus="preview"] { color: #1d4ed8; }
QLabel#LogicStepBadge[stepStatus="acked"] { color: #2e7d32; }
QLabel#LogicStepBadge[stepStatus="failed"] { color: #c0392b; }
QFrame#CollabTrialBar {
    background-color: #faf8f4;
    border: 1px solid #e6e1d6;
    border-radius: 10px;
}
