{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minashigo.local/pack/script.schema.json",
  "title": "MinashigoPackScript",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "initial", "states"],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1" },
    "initial": { "type": "string", "minLength": 1 },
    "states": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/state" }
    }
  },
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "detect": {
          "type": "array",
          "items": { "$ref": "#/$defs/detect" }
        },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        },
        "on_miss": { "type": "string" }
      }
    },
    "detect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "goto"],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "goto": { "type": "string", "minLength": 1 }
      }
    },
    "action": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["click_image", "click_xy", "sleep", "goto", "log", "exit"]
        },
        "image": { "type": "string" },
        "threshold": { "type": "number" },
        "expect": { "type": "string", "enum": ["none", "gone", "appear"] },
        "appear_image": { "type": "string" },
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "nx": { "type": "number", "minimum": 0, "maximum": 1 },
        "ny": { "type": "number", "minimum": 0, "maximum": 1 },
        "ms": { "type": "integer", "minimum": 0 },
        "ms_min": { "type": "integer", "minimum": 0 },
        "ms_max": { "type": "integer", "minimum": 0 },
        "state": { "type": "string" },
        "message": { "type": "string" },
        "ok": { "type": "boolean" }
      }
    }
  }
}
